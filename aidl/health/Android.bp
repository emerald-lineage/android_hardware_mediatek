cc_defaults {
    name: "android.hardware.health-service.mediatek-defaults",
    defaults: [
        "libhealth_aidl_impl_user",
        "libhealth_aidl_charger_defaults",
    ],
    relative_install_path: "hw",
    vintf_fragments: ["android.hardware.health-service.mediatek.xml"],
    srcs: [
        "Health.cpp",
    ],
    static_libs: [
        "libhealth_aidl_impl",
    ],
}

cc_binary {
    name: "android.hardware.health-service.mediatek",
    defaults: ["android.hardware.health-service.mediatek-defaults"],
    vendor: true,
    init_rc: ["android.hardware.health-service.mediatek.rc"],
    overrides: ["charger"],
    // Also used on prebuilt vendor images, which may lack this health NDK version and ship
    // older copies of the other libraries: link everything that is not LLNDK into the binary.
    stl: "c++_static",
    target: {
        vendor: {
            exclude_shared_libs: [
                "android.hardware.health-V5-ndk",
                "libbase",
                "libcutils",
                "libhidlbase",
                "libpng",
                "libutils",
            ],
            static_libs: [
                "android.hardware.health-V5-ndk",
                "libbase",
                "libcutils",
                "libhidlbase",
                "libpng",
                "libutils",
                // for libpng
                "libz",
            ],
        },
    },
}

cc_binary {
    name: "android.hardware.health-service.mediatek-recovery",
    defaults: ["android.hardware.health-service.mediatek-defaults"],
    recovery: true,
    init_rc: ["android.hardware.health-service.mediatek-recovery.rc"],
    overrides: ["charger.recovery"],
}
